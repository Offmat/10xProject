#!/bin/bash -e

# Railway and similar platforms inject PORT; Thruster must listen on it (not default 80).
if [ -n "${PORT:-}" ]; then
  export HTTP_PORT="${HTTP_PORT:-$PORT}"
fi

# If running the rails server then create or migrate existing database
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare
fi

exec "${@}"
