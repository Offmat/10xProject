<% content_for :title, 'Forgot password' %>

<%= render layout: 'shared/auth_card', locals: {
      title: 'Forgot your password?',
      subtitle: 'Enter your email and we will send reset instructions.'
    } do %>
  <%= form_with url: passwords_path, class: 'space-y-4' do |form| %>
    <div class="form-control">
      <label class="label" for="email">
        <span class="label-text">Email</span>
      </label>
      <%= form.email_field :email, required: true, autofocus: true, autocomplete: 'username',
            placeholder: 'Enter your email', value: params[:email], id: 'email',
            class: 'input input-bordered w-full' %>
    </div>

    <%= form.submit 'Email reset instructions', class: 'btn btn-primary w-full' %>
  <% end %>
<% end %>
